# =============================================================
# Plantilla de variables de entorno — Odyssey
# Copia este archivo como `.env` antes de ejecutar localmente
# =============================================================

# Base de Datos Relacional (MySQL 8 / MariaDB)
DB_URL=jdbc:mysql://localhost:3306/odyxsvg_db?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=

# Base de Datos Documental (MongoDB 7 - Telemetria, reportes y geo)
MONGO_URI=mongodb://localhost:27017/odyssey_nosql

# Cache en Memoria (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379

# Servidor HTTP
PORT=8080

# Google Gemini API Key (opcional: si no se define, usa fallback local)
GEMINI_API_KEY=

# SMTP (opcional: codigos OTP por correo y recuperacion de contrasena)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
